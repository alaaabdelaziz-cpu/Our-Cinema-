        btn.style.opacity = isFilled ? '0.95' : '0.45';

        // Mini perforated ticket SVG inside each rating box (just like Megabox Original Ticket)
        btn.innerHTML = `
          <span class="text-[5px] font-mono leading-none font-bold tracking-tighter">TKT</span>
          <span class="w-2.5 h-[1px] my-[1px] bg-current opacity-60"></span>
