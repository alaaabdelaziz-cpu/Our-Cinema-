            <span class="w-4 h-5 rounded-[2px] inline-flex flex-col items-center justify-center border"
                  style="border-color:${m.colors.ink}; background:${filled ? m.colors.ink : 'transparent'}; color:${filled ? m.colors.bg : m.colors.ink}; opacity:${filled ? '0.95' : '0.45'};">
              <span style="font-size:5px; font-family:monospace; line-height:1; font-weight:bold;">TKT</span>
              <span style="width:10px; height:1px; margin:1px 0; background:currentColor; opacity:0.6;"></span>
              <span style="font-size:5px; font-family:monospace; line-height:1;">${i}</span>
            </span>`;
        }

        const qrId = `batch-qr-${idx}`;
        const pageDiv = document.createElement('div');
        pageDiv.className = 'batch-page';
        pageDiv.innerHTML = `
          <div class="tickets-wrapper">
            <!-- FRONT -->
            <div class="ticket-scalloped overflow-hidden flex flex-col justify-between" style="background-color:${m.colors.bg}; color:${m.colors.ink};">
              <img src="${m.poster}" alt="${m.title}" class="absolute inset-0 w-full h-full object-cover object-center scale-110 blur-[1.5px] opacity-45" />
              <div class="absolute inset-0" style="background:${washBg};"></div>
              <div class="matte-sheen absolute inset-0"></div>
              <div class="paper-grain absolute inset-0"></div>

              <div class="relative z-10 flex flex-col h-full px-4 py-4 justify-between">
                <div>
                  <div class="flex items-center justify-between text-[8.5px] font-display tracking-[0.14em] uppercase opacity-90 pb-1.5" style="border-bottom: 1px solid ${borderCol};">
                    <span>ORIGINAL COLLECTOR TICKET</span>
                    <span class="font-mono">${m.editionNo}</span>
                  </div>

                  <div class="pt-2 pb-2.5" style="border-bottom: 1px solid ${borderCol};">
                    <div class="flex items-center justify-between text-[8px] font-mono uppercase tracking-wider opacity-75 mb-1">
                      <span>Title</span>
                      <span>${m.year}</span>
                    </div>
                    <div class="text-center py-1.5 px-1">
                      <h2 class="text-[18px] leading-tight font-bold tracking-wide uppercase ${titleFont}">${m.title}</h2>
                      <p class="text-[10px] opacity-85 mt-0.5 tracking-widest font-medium">${m.subtitle}</p>
                    </div>
                  </div>

                  <div class="py-2.5 space-y-1.5 text-[9px] leading-snug" style="border-bottom: 1px solid ${borderCol};">
                    <div class="grid grid-cols-12 items-baseline">
                      <span class="col-span-4 opacity-70 font-mono text-[8px] uppercase">Release</span>
                      <span class="col-span-8 font-medium tracking-wide">${m.release}</span>
                    </div>
                    <div class="grid grid-cols-12 items-baseline">
                      <span class="col-span-4 opacity-70 font-mono text-[8px] uppercase">Director</span>
                      <span class="col-span-8 font-medium">${m.director}</span>
                    </div>
                    <div class="grid grid-cols-12 items-baseline">
                      <span class="col-span-4 opacity-70 font-mono text-[8px] uppercase">Cast</span>
                      <span class="col-span-8 font-medium line-clamp-2">${m.cast}</span>
                    </div>
                    <div class="grid grid-cols-12 items-baseline">
                      <span class="col-span-4 opacity-70 font-mono text-[8px] uppercase">Format</span>
                      <span class="col-span-8 font-mono text-[8.5px]" style="color:${m.colors.accent};">${m.formatMeta}</span>
                    </div>
                  </div>

                  <div class="py-2 flex items-center justify-between" style="border-bottom: 1px solid ${borderCol};">
                    <span class="text-[8px] font-mono uppercase opacity-75">Rating</span>
                    <div class="flex items-center gap-1.5">${ratingHtml}</div>
                    <span class="text-[9px] font-mono tracking-tighter opacity-90">( ${m.rating} / 5 )</span>
                  </div>

                  <div class="py-2" style="border-bottom: 1px solid ${borderCol};">
                    <div class="flex items-center justify-between">
                      <span class="text-[8px] font-mono uppercase opacity-75">Movie Quote</span>
                      <span class="text-[7.5px] font-mono opacity-65">REF: ${m.bookingRef}</span>
                    </div>
                    <p class="text-[9px] italic font-serif mt-1 leading-[1.3] line-clamp-3">${activeQuote}</p>
                  </div>
                </div>

                <div class="relative pt-1">
                  <div class="grid grid-cols-2 py-1.5 text-[8.5px]" style="border-bottom: 1px solid ${borderCol};">
                    <div class="pr-2" style="border-right: 1px dashed ${borderCol};">
                      <div class="text-[7.5px] font-mono uppercase opacity-70">Date</div>
                      <div class="font-semibold mt-0.5 truncate">${m.date}</div>
                    </div>
                    <div class="pl-2.5">
                      <div class="text-[7.5px] font-mono uppercase opacity-70">Time</div>
                      <div class="font-semibold mt-0.5 truncate">${m.time}</div>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 pt-1.5 pb-6 text-[8.5px] relative">
                    <div class="pr-2" style="border-right: 1px dashed ${borderCol};">
                      <div class="text-[7.5px] font-mono uppercase opacity-70">Theater</div>
                      <div class="font-semibold mt-0.5 leading-tight">${m.theater}</div>
                      <div class="text-[8px] font-mono mt-1 opacity-90" style="color:${m.colors.accent};">${m.seats}</div>
                    </div>
                    <div class="pl-2.5">
                      <div class="text-[7.5px] font-mono uppercase opacity-70">Screen</div>
                      <div class="font-semibold mt-0.5 leading-tight">${m.screen}</div>
                    </div>
                  </div>

                  <div class="flex items-center justify-between pt-1 text-[7.5px] font-display tracking-[0.16em] uppercase opacity-85">
                    <span>${m.tagline}</span>
                    <span class="font-mono text-[7px] opacity-70">ORIGINAL ARCHIVE</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- BACK -->
            <div class="ticket-scalloped overflow-hidden flex flex-col justify-between" style="background-color:${m.colors.bg}; color:${m.colors.ink};">
              <img src="${m.poster}" alt="${m.title}" class="absolute inset-0 w-full h-full object-cover object-center" />
              <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,14,16,0.22) 0%, rgba(10,14,16,0.05) 45%, rgba(10,14,16,0.78) 100%);"></div>
              <div class="matte-sheen absolute inset-0"></div>
              <div class="paper-grain absolute inset-0"></div>

              <div class="relative z-10 flex flex-col justify-between h-full p-4">
                <div class="flex items-center justify-between text-[8px] font-mono uppercase tracking-widest opacity-80">
                  <span class="px-1.5 py-0.5 rounded bg-black/35">${m.screen.toUpperCase()}</span>
                  <span class="px-1.5 py-0.5 rounded bg-black/35">${m.year.replace(/[\[\]]/g, '')}</span>
                </div>

                <div class="mt-auto">
                  ${showQrBack ? `
                    <div class="flex items-end justify-between gap-2.5 bg-black/60 p-2.5 rounded-xl border border-white/15">
                      <div class="min-w-0 flex-1">
                        <div class="text-[7px] font-mono uppercase tracking-widest opacity-70">ADMIT • COLLECTOR PASS</div>
                        <div class="text-xs font-bold uppercase tracking-wider truncate mt-0.5" style="color:${m.colors.accent};">${m.title}</div>
                        <div class="text-[8.5px] font-mono text-white/90 truncate mt-0.5">${m.seats} • ${m.time}</div>
                        <div class="text-[7.5px] font-mono text-white/65 truncate mt-0.5">REF: ${m.bookingRef}</div>
                      </div>
                      <div id="${qrId}" class="bg-white p-1 rounded-md shrink-0"></div>
                    </div>
                  ` : `
                    <div class="text-center pb-2">
                      <p class="text-sm font-bold tracking-[0.22em] uppercase ${titleFont}" style="color:${m.colors.accent};">${m.title.toLowerCase()}</p>
                    </div>
                  `}
                </div>
              </div>
            </div>
          </div>
          <div class="print-guides">
            ✂ ${m.editionNo} — ${m.title} (${m.date}) • TRUE COLLECTIBLE DIMENSIONS: 70mm × 140mm EACH
          </div>
        `;
        batchContainer.appendChild(pageDiv);

        if (showQrBack) {
          const qrEl = document.getElementById(qrId);
          if (qrEl) {
            new QRCode(qrEl, {
              text: `MOVIE:${m.title}|REF:${m.bookingRef}|SEATS:${m.seats}|DATE:${m.date}`,
              width: 52,
              height: 52,
              colorDark: '#111111',
              colorLight: '#ffffff',
              correctLevel: QRCode.CorrectLevel.M
            });
          }
        }
      });

      document.body.classList.add('print-batch-mode');
      setTimeout(() => {
        window.print();
        document.body.classList.remove('print-batch-mode');
      }, 250);
    }

    // =========================================================================
    // VIEW MODE & UTILITIES
    // =========================================================================
    function setViewMode(mode) {
      const front = document.getElementById('ticket-front');
      const back = document.getElementById('ticket-back');

      ['dual', 'front', 'back'].forEach(m => {
        const b = document.getElementById(`view-${m}`);
        b.classList.remove('bg-white/15', 'text-white');
        b.classList.add('text-neutral-400');
      });
      const active = document.getElementById(`view-${mode}`);
      active.classList.add('bg-white/15', 'text-white');
      active.classList.remove('text-neutral-400');

      if (mode === 'dual') {
        front.classList.remove('hidden');
        back.classList.remove('hidden');
      } else if (mode === 'front') {
        front.classList.remove('hidden');
        back.classList.add('hidden');
      } else {
        front.classList.add('hidden');
        back.classList.remove('hidden');
      }
    }

    function hexToRgba(hex, alpha) {
      const clean = hex.replace('#', '');
      const bigint = parseInt(clean, 16);
      const r = (bigint >> 16) & 255;
      const g = (bigint >> 8) & 255;
      const b = bigint & 255;
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function rgbToHex(r, g, b) {
      return '#' + [r, g, b].map(x => {
        const hex = x.toString(16);
        return hex.length === 1 ? '0' + hex : hex;
      }).join('');
    }

    let toastTimer;
    function showToast(message, isWarn = false) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toast-msg');
      const dot = document.getElementById('toast-dot');

      msg.textContent = message;
      dot.className = `w-2.5 h-2.5 rounded-full ${isWarn ? 'bg-amber-400' : 'bg-emerald-400'}`;

      toast.classList.remove('translate-y-20', 'opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }
  </script>
</body>
</html>
