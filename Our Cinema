<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ORIGINAL TICKET STUDIO — Collectible Cinema Tickets</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Arabic:wght@400;600;700&family=Oswald:wght@500;700&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'Noto Sans Arabic', 'sans-serif'],
            mono: ['Courier Prime', 'monospace'],
            display: ['Oswald', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
            gothic: ['Cinzel', 'serif'],
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --tkt-bg: #1e3336;
      --tkt-bg-secondary: #2d4749;
      --tkt-ink: #f2ede4;
      --tkt-accent: #d4894a;
      --tkt-border: rgba(242, 237, 228, 0.45);
      --tkt-grain: 0.22;
      --tkt-overlay-opacity: 0.72;
    }

    body {
      background-color: #0e1113;
      color: #f3f4f6;
      overflow-x: hidden;
    }

    /* Authentic Scalloped Perforated Ticket Edge Mask */
    .ticket-scalloped {
      position: relative;
      width: 280px;
      height: 560px;
      flex-shrink: 0;
      box-shadow: 0 28px 60px -12px rgba(0, 0, 0, 0.78), 0 8px 24px -6px rgba(0, 0, 0, 0.5);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
      /* Scalloped corners & 7 circular perforations on top & bottom edges */
      -webkit-mask-image:
        radial-gradient(circle 10px at 0 0, transparent 98%, black 100%),
        radial-gradient(circle 10px at 100% 0, transparent 98%, black 100%),
        radial-gradient(circle 10px at 0 100%, transparent 98%, black 100%),
        radial-gradient(circle 10px at 100% 100%, transparent 98%, black 100%),
        radial-gradient(circle 6.5px at 35px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 70px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 105px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 140px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 175px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 210px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 245px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 35px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 70px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 105px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 140px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 175px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 210px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 245px 100%, transparent 96%, black 100%);
      -webkit-mask-composite: destination-in;
      mask-image:
        radial-gradient(circle 10px at 0 0, transparent 98%, black 100%),
        radial-gradient(circle 10px at 100% 0, transparent 98%, black 100%),
        radial-gradient(circle 10px at 0 100%, transparent 98%, black 100%),
        radial-gradient(circle 10px at 100% 100%, transparent 98%, black 100%),
        radial-gradient(circle 6.5px at 35px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 70px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 105px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 140px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 175px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 210px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 245px 0, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 35px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 70px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 105px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 140px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 175px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 210px 100%, transparent 96%, black 100%),
        radial-gradient(circle 6.5px at 245px 100%, transparent 96%, black 100%);
      mask-composite: intersect;
    }

    .ticket-scalloped:hover {
      transform: translateY(-4px);
    }

    /* Vintage Matte Cotton Paper & Film Grain Overlay */
    .paper-grain {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.55'/%3E%3C/svg%3E");
      mix-blend-mode: overlay;
      opacity: var(--tkt-grain);
      pointer-events: none;
    }

    /* Subtle Horizontal Micro-Fiber Lines */
    .matte-sheen {
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.14) 0%,
        rgba(255, 255, 255, 0.02) 45%,
        rgba(0, 0, 0, 0.12) 100%
      );
      pointer-events: none;
    }

    /* Custom Scrollbar for Editor Panel */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #14181b;
    }
    ::-webkit-scrollbar-thumb {
      background: #2f373e;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #48535d;
    }

    /* Rating Stamp Box */
    .rating-stamp {
      transition: all 0.18s ease;
    }
    .rating-stamp:hover {
      transform: scale(1.08);
    }

    /* PRINT STYLESHEET — Exact 70mm x 140mm Collectible Output */
    @media print {
      @page {
        size: A4 portrait;
        margin: 15mm;
      }

      html, body {
        background: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .no-print {
        display: none !important;
      }

      #print-stage {
        position: static !important;
        width: 100% !important;
        min-height: auto !important;
        padding: 0 !important;
        margin: 0 !important;
        background: transparent !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-start !important;
      }

      .tickets-wrapper {
        display: flex !important;
        flex-direction: row !important;
        gap: 14mm !important;
        justify-content: center !important;
        align-items: flex-start !important;
        padding-top: 12mm !important;
      }

      .ticket-scalloped {
        width: 70mm !important;
        height: 140mm !important;
        box-shadow: none !important;
        transform: none !important;
        border: 0.25mm dashed rgba(0, 0, 0, 0.25) !important;
        -webkit-mask-image:
          radial-gradient(circle 2.5mm at 0 0, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 100% 0, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 0 100%, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 100% 100%, transparent 98%, black 100%),
          radial-gradient(circle 1.6mm at 8.75mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 17.5mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 26.25mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 35mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 43.75mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 52.5mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 61.25mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 8.75mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 17.5mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 26.25mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 35mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 43.75mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 52.5mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 61.25mm 100%, transparent 96%, black 100%) !important;
        mask-image:
          radial-gradient(circle 2.5mm at 0 0, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 100% 0, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 0 100%, transparent 98%, black 100%),
          radial-gradient(circle 2.5mm at 100% 100%, transparent 98%, black 100%),
          radial-gradient(circle 1.6mm at 8.75mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 17.5mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 26.25mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 35mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 43.75mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 52.5mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 61.25mm 0, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 8.75mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 17.5mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 26.25mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 35mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 43.75mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 52.5mm 100%, transparent 96%, black 100%),
          radial-gradient(circle 1.6mm at 61.25mm 100%, transparent 96%, black 100%) !important;
      }

      .print-guides {
        display: block !important;
        margin-top: 8mm;
        font-family: 'Courier Prime', monospace;
        font-size: 9pt;
        color: #555555;
        text-align: center;
      }

      /* Batch Print All 6 Collection Mode */
      body.print-batch-mode #print-stage {
        display: none !important;
      }

      body.print-batch-mode #batch-print-container {
        display: block !important;
      }

      .batch-page {
        page-break-after: always;
        break-after: page;
        padding-top: 8mm;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .batch-page:last-child {
        page-break-after: auto;
        break-after: auto;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-amber-500/30 selection:text-amber-200">

  <!-- Toast Notification -->
  <div id="toast" class="no-print fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-neutral-900/95 border border-white/15 text-neutral-100 px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 text-sm backdrop-blur-md">
    <span id="toast-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
    <span id="toast-msg">Ticket updated</span>
  </div>

  <!-- Top Navigation Bar -->
  <header class="no-print sticky top-0 z-30 bg-[#121619]/90 backdrop-blur-md border-b border-white/10 px-4 sm:px-6 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500/20 to-teal-500/20 border border-white/15 flex items-center justify-center shadow-inner">
          <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-sm sm:text-base font-bold tracking-wider uppercase text-white">Original Ticket Studio</h1>
            <span class="hidden sm:inline-block text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/10 text-neutral-300 border border-white/10">70×140mm ARCHIVE</span>
          </div>
          <p class="text-xs text-neutral-400 hidden sm:block">Collectible perforated cinema stubs with dynamic poster palettes</p>
        </div>
      </div>

      <!-- Primary Actions -->
      <div class="flex items-center gap-2">
        <div class="hidden xl:flex items-center bg-white/5 border border-white/10 rounded-xl p-0.5 mr-1">
          <button onclick="applyGlobalQuoteVibe('romantic')" class="px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-rose-200 hover:bg-rose-500/20 transition cursor-pointer" title="Set all 6 collection tickets to Romantic / Heartfelt quotes">
            ♥ All 6: Romantic
          </button>
          <button onclick="applyGlobalQuoteVibe('deep')" class="px-2.5 py-1.5 rounded-lg text-[11px] font-medium text-amber-200 hover:bg-amber-500/20 transition cursor-pointer" title="Set all 6 collection tickets to Deep Meaning quotes">
            ✦ All 6: Deep
          </button>
        </div>
        <button onclick="printSingleTicket()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-neutral-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-1.5 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print Ticket (70×140mm)</span>
        </button>
        <button onclick="printAllCollection()" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-neutral-100 font-semibold text-xs transition-all flex items-center gap-1.5 cursor-pointer" title="Print all 6 movies on A4/Letter pages">
          <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="hidden sm:inline">Print All 6 Collection</span>
          <span class="sm:hidden">All 6</span>
        </button>
      </div>
    </div>

    <!-- Scrollable 6-Movie Archive + Custom Preset Strip -->
    <div class="max-w-7xl mx-auto mt-3 pt-2.5 border-t border-white/10 flex items-center gap-2 overflow-x-auto pb-1">
      <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 shrink-0 mr-1">Cinema History:</span>

      <button onclick="loadPreset('spiderman')" id="btn-preset-spiderman" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 bg-white/15 text-white shadow border border-white/10 cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#d62828]"></span>
        <span>01. Spider-Man: Brand New Day</span>
        <span class="text-[10px] font-mono opacity-65">Aug 15</span>
      </button>

      <button onclick="loadPreset('odyssey')" id="btn-preset-odyssey" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#e07a2d]"></span>
        <span>02. The Odyssey</span>
        <span class="text-[10px] font-mono opacity-65">Sep 10</span>
      </button>

      <button onclick="loadPreset('digger')" id="btn-preset-digger" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#d8b46c]"></span>
        <span>03. Digger</span>
        <span class="text-[10px] font-mono opacity-65">Oct 03</span>
      </button>

      <button onclick="loadPreset('wildwood')" id="btn-preset-wildwood" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#d98b3c]"></span>
        <span>04. Wildwood</span>
        <span class="text-[10px] font-mono opacity-65">Nov 01</span>
      </button>

      <button onclick="loadPreset('clayface')" id="btn-preset-clayface" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#d98a4e]"></span>
        <span>05. Clayface</span>
        <span class="text-[10px] font-mono opacity-65">Nov 10</span>
      </button>

      <button onclick="loadPreset('ebenezer')" id="btn-preset-ebenezer" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-2 text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent cursor-pointer">
        <span class="w-2.5 h-2.5 rounded-full bg-[#d4a853]"></span>
        <span>06. Ebenezer (إبنيزر)</span>
        <span class="text-[10px] font-mono opacity-65">Nov 15</span>
      </button>

      <button onclick="loadPreset('custom')" id="btn-preset-custom" class="preset-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 text-teal-300 hover:text-teal-200 bg-teal-500/10 hover:bg-teal-500/20 border border-teal-500/25 cursor-pointer">
        <span>+ Custom Movie</span>
      </button>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-7xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-0 lg:gap-6 p-0 sm:p-4 lg:p-6">

    <!-- LEFT / TOP: Interactive Ticket Stage -->
    <section id="print-stage" class="lg:col-span-7 xl:col-span-8 flex flex-col items-center justify-center rounded-none sm:rounded-3xl bg-[#151b1e] border-b sm:border border-white/10 p-6 sm:p-10 relative overflow-hidden min-h-[660px]">
      <!-- Ambient Studio Backdrop Glow matching Ticket Palette -->
      <div id="ambient-glow" class="no-print absolute inset-0 opacity-30 blur-3xl pointer-events-none transition-colors duration-700" style="background: radial-gradient(circle at 50% 45%, #d4894a 0%, #1e3336 55%, transparent 80%);"></div>

      <!-- View Controls Bar -->
      <div class="no-print relative z-10 w-full max-w-xl flex flex-wrap items-center justify-between gap-2 mb-6 bg-black/35 backdrop-blur-md px-3.5 py-2 rounded-2xl border border-white/10">
        <div class="flex items-center gap-2 text-xs text-neutral-300">
          <span class="font-mono uppercase tracking-wider text-neutral-400">Preview:</span>
          <button onclick="setViewMode('dual')" id="view-dual" class="px-2.5 py-1 rounded-lg bg-white/15 text-white font-medium text-xs transition">Front & Back</button>
          <button onclick="setViewMode('front')" id="view-front" class="px-2.5 py-1 rounded-lg text-neutral-400 hover:text-white font-medium text-xs transition">Front Only</button>
          <button onclick="setViewMode('back')" id="view-back" class="px-2.5 py-1 rounded-lg text-neutral-400 hover:text-white font-medium text-xs transition">Back Artwork</button>
        </div>

        <div class="flex items-center gap-3">
          <label class="flex items-center gap-1.5 text-xs text-neutral-300 cursor-pointer select-none">
            <input type="checkbox" id="toggle-qr-back" checked onchange="updateTicket()" class="rounded accent-amber-500 cursor-pointer" />
            <span>QR Stub on Back</span>
          </label>
        </div>
      </div>

      <!-- TICKETS DISPLAY CONTAINER (Front & Back Side-by-Side) -->
      <div class="tickets-wrapper relative z-10 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-10 my-auto">

        <!-- =========================================================
             FRONT TICKET (Megabox Original Ticket Metadata & Grid)
             ========================================================= -->
        <div id="ticket-front" class="ticket-scalloped select-none overflow-hidden flex flex-col justify-between" style="background-color: var(--tkt-bg); color: var(--tkt-ink);">
          <!-- Atmospheric Poster Bleed Background -->
          <img id="front-bg-poster" src="" alt="Movie Backdrop" crossorigin="anonymous" class="absolute inset-0 w-full h-full object-cover object-center scale-110 blur-[1.5px] opacity-45 transition-all duration-500" />
          <!-- Color Palette Duotone Wash -->
          <div id="front-color-wash" class="absolute inset-0 transition-colors duration-500" style="background: linear-gradient(175deg, rgba(30,51,54,0.82) 0%, rgba(45,71,73,0.72) 52%, rgba(20,32,34,0.92) 100%);"></div>
          <!-- Matte Sheen & Vintage Film Grain -->
          <div class="matte-sheen absolute inset-0"></div>
          <div class="paper-grain absolute inset-0"></div>

          <!-- Inner Content Wrapper -->
          <div class="relative z-10 flex flex-col h-full px-4 py-4 justify-between">

            <!-- Top Header Bar -->
            <div>
              <div class="flex items-center justify-between text-[8.5px] font-display tracking-[0.14em] uppercase opacity-90 pb-1.5" style="border-bottom: 1px solid var(--tkt-border);">
                <span id="disp-series-brand">ORIGINAL COLLECTOR TICKET</span>
                <span id="disp-edition-no" class="font-mono">No. 01</span>
              </div>

              <!-- Title Section -->
              <div class="pt-2 pb-2.5" style="border-bottom: 1px solid var(--tkt-border);">
                <div class="flex items-center justify-between text-[8px] font-mono uppercase tracking-wider opacity-75 mb-1">
                  <span>Title</span>
                  <span id="disp-year">[2026]</span>
                </div>
                <div class="text-center py-1.5 px-1">
                  <h2 id="disp-title" class="text-[19px] leading-tight font-bold tracking-wide uppercase drop-shadow-sm">CLAYFACE</h2>
                  <p id="disp-subtitle" class="text-[10.5px] opacity-85 mt-0.5 tracking-widest font-medium">GOTHAM NOCTURNE EDITION</p>
                </div>
              </div>

