    function extractPaletteFromPoster(silentFallback = false) {
      const img = document.getElementById('back-poster-img');
      const canvas = document.getElementById('palette-canvas');
      const ctx = canvas.getContext('2d');

      try {
        ctx.clearRect(0, 0, 64, 64);
        ctx.drawImage(img, 0, 0, 64, 64);
        const pixels = ctx.getImageData(0, 0, 64, 64).data;

        let rSum = 0, gSum = 0, bSum = 0, count = 0;
        let maxSat = -1;
        let accentRGB = [216, 180, 108];

        for (let i = 0; i < pixels.length; i += 16) {
          const r = pixels[i];
          const g = pixels[i + 1];
          const b = pixels[i + 2];
          const a = pixels[i + 3];
          if (a < 128) continue;

          rSum += r;
          gSum += g;
          bSum += b;
          count++;

          // Find vibrant accent candidate
          const max = Math.max(r, g, b);
          const min = Math.min(r, g, b);
          const sat = max === 0 ? 0 : (max - min) / max;
          const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          if (sat > maxSat && lum > 0.25 && lum < 0.85) {
            maxSat = sat;
            accentRGB = [r, g, b];
          }
        }

        if (count > 0) {
          // Darken average slightly so paper ink remains legible
          const avgR = Math.max(18, Math.floor((rSum / count) * 0.52));
          const avgG = Math.max(20, Math.floor((gSum / count) * 0.52));
          const avgB = Math.max(22, Math.floor((bSum / count) * 0.52));

          const secR = Math.min(255, avgR + 24);
          const secG = Math.min(255, avgG + 26);
          const secB = Math.min(255, avgB + 28);

          document.getElementById('inp-color-bg').value = rgbToHex(avgR, avgG, avgB);
          document.getElementById('inp-color-bg2').value = rgbToHex(secR, secG, secB);
          document.getElementById('inp-color-accent').value = rgbToHex(accentRGB[0], accentRGB[1], accentRGB[2]);
          document.getElementById('inp-color-ink').value = '#f4efe6';

          updateColors();
          if (!silentFallback) {
            showToast('Extracted color palette from poster!');
          }
        }
      } catch (err) {
        // Cross-origin protection fallback for external URLs without CORS headers
        if (!silentFallback) {
          showToast('External image CORS protected — using curated fallback palette', true);
        }
      }
    }

